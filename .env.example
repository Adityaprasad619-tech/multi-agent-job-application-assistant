# ===== Multi-Agent Job Search System — Environment Variables =====
# Copy this file to .env and fill in your keys.

# --- Groq LLM API ---
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- USAJobs API ---
# Register at: https://developer.usajobs.gov/APIRequest/Index
USAJOBS_API_KEY=your_usajobs_api_key_here
USAJOBS_EMAIL=your_email@example.com

# --- Groq Model (optional, defaults to llama-3.3-70b-versatile) ---
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# --- Database Configuration ---
# Optional: Path to SQLite database file. Resolves relative to project root.
# Defaults to database/job_search.db
DATABASE_PATH=database/job_search.db

# --- Authentication ---
# Provider: "local" (default, SQLite+bcrypt) or "clerk" (requires keys below)
AUTH_PROVIDER=local

# --- Clerk (only required if AUTH_PROVIDER=clerk) ---
# Get keys at: https://dashboard.clerk.com
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# --- Development ---
# Set to true to use mock agent outputs (no Groq API calls consumed)
TEST_MODE=false
